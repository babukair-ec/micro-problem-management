datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Problem {
  id                 Int       @id @default(autoincrement())
  outer_id           String    @unique @default(uuid()) @db.Uuid
  task_id            String?   @db.Uuid
  project_id         String?   @db.Uuid
  reported_by_id     String    @db.Uuid
  description        String    @db.Text
  status             String    @default("OPEN") @db.VarChar(50)
  resolver_id        String?   @db.Uuid
  resolution_task_id String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz
  resolved_at        DateTime? @db.Timestamptz
  resolution         String?   @db.Text

  @@index([task_id])
  @@index([project_id])
  @@index([status])
  @@map("problems")
}

model EmployeeCache {
  id            Int      @id @default(autoincrement())
  outer_id      String   @unique @db.Uuid
  username      String   @db.VarChar(150)
  full_name     String?  @db.VarChar(255)
  email         String?  @db.VarChar(255)
  department    String?  @db.VarChar(100)
  job_title     String?  @db.VarChar(100)
  employee_type String   @default("EMPLOYEE") @db.VarChar(50)
  is_active     Boolean  @default(true)
  updated_at    DateTime @default(now()) @db.Timestamptz

  @@map("employee_cache")
}
